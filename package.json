{
  "name": "@nymrel/website-audit-plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:live": "tsc -p tsconfig.json && node scripts/live-audit.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "node scripts/verify-toolchain.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node --test test/*.test.mjs && node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "1.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright": "1.62.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
